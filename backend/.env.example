# ==============================================================================
# MDIP — Document Ingestion Pipeline (Backend Environment Configuration)
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# Directory where SQLite DB (documents.db) and uploaded files (originals/) are stored.
# Default: data (relative to working directory)
DATA_DIR=data

# Maximum allowed upload file size in bytes (10 MiB = 10 * 1024 * 1024 = 10485760).
# Files exceeding this limit are rejected with HTTP 413.
MAX_UPLOAD_BYTES=10485760

# Comma-separated list of allowed frontend CORS origins.
# For local dev, defaults to Vite's dev server addresses.
# For production, set to your frontend domain(s), e.g.:
# CORS_ORIGINS=https://app.example.com,https://example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional specialist extractor demo: disabled or mock. No network calls.
# Demo PDF receives a fixture table; other eligible pages receive a generic mock notice.
AI_FALLBACK=disabled
